{
    "name": "alex/dansk",
    "description": "Danish idiom trainer - quiz web app, Telegram importer, shared API",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "nikic/fast-route": "^1.3",
        "halaxa/json-machine": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Dansk\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Dansk\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
