{
    "name": "alex/dansk",
    "description": "Danish idiom trainer - quiz web app, Telegram importer, shared API",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "anthropic-ai/sdk": "^1.3",
        "guzzlehttp/guzzle": "^8.3",
        "halaxa/json-machine": "^1.1",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Dansk\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Dansk\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
